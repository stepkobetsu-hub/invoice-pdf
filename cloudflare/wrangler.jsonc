{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "step-invoice-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "production",
    "PRODUCTION_SEND_APPROVED": "false",
    "TEST_SEND_APPROVED": "false",
    "PUBLIC_DOWNLOAD_ENABLED": "true",
    "PDF_UPLOAD_ENABLED": "true",
    "ADMIN_API_ENABLED": "true",
    "EMERGENCY_STOP": "false",
    "APP_ORIGIN": "https://stepkobetsu-hub.github.io",
    "STAFF_AUTH_API_URL": "https://script.google.com/macros/s/AKfycbypkUc0MqZ07E7pZRglNPeRM56WbCcuWaLpRzi9bVFcPklHDxaaLC7GfzG6ozTGCbEX/exec",
    "INVOICE_API_URL": "https://script.google.com/macros/s/AKfycbwo1DdSQ2eUVVU35v1TqermHTgIEsT1u4U-M_67KfA50VelbHsh28W_pec56OlyBkxqaw/exec",
    "PARENT_LINK_TTL_DAYS": "180",
    "PDF_DOWNLOAD_MAX_TOTAL": "20",
    "PDF_DOWNLOAD_MAX_DAILY": "10",
    "BULK_SEND_MAX": "100",
    "DAILY_SEND_MAX": "200"
  },
  "ratelimits": [
    { "name": "PAGE_IP_RATE_LIMITER", "namespace_id": "31001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PAGE_TOKEN_RATE_LIMITER", "namespace_id": "31002", "simple": { "limit": 10, "period": 60 } },
    { "name": "PDF_IP_RATE_LIMITER", "namespace_id": "31003", "simple": { "limit": 10, "period": 60 } },
    { "name": "PDF_TOKEN_RATE_LIMITER", "namespace_id": "31004", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "step-invoice-db",
      "database_id": "e92d6d76-04d2-40de-9ddf-8804850402c8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "step-invoice-pdfs"
    }
  ]
}
